# Copy this file to backend/.env and fill it in. backend/.env is ignored by git,
# so your key never gets committed. Don't put real keys in this example file.

# Your Google Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 1 = use Gemini to check whether a new question matches an existing group.
# 0 = rule-based matching only (no key needed).
USE_AI_GROUPING=0

# Optional overrides (defaults shown).
# AI_MODEL=gemini-3.5-flash   (gemini-3.5-flash-lite is cheaper and faster)
# AI_TIMEOUT_SECONDS=5
